{
    "manifest_version": 3,
    "name": "Poe Voice Sync",
    "version": "1.1",
    "description": "Sync ElevenLabs voice models with POE AI chatbot responses.",
    "permissions": [
        "storage",
        "scripting",
        "activeTab",
        "identity",
        "identity.email",
        "tabs"
    ],
    "host_permissions": [
        "*://*.poe.com/*",
        "https://api.elevenlabs.io/*",
        "https://gds-g.github.io/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "oauth2": {
        "client_id": "727891588328-oh57b7j5ebdf5289l84aorm4n5p7knll.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/userinfo.email",
            "https://www.googleapis.com/auth/userinfo.profile"
        ]
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [ "*://*.poe.com/*" ],
            "js": [ "content.js" ],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [ "icons/*", "*.js" ],
            "matches": [ "*://*.poe.com/*", "*://*/*" ]
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}