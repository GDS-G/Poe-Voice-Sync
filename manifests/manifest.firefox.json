{
    "manifest_version": 3,
    "name": "Poe Voice Sync",
    "version": "1.2.1",
    "description": "Read Poe chatbot responses with ElevenLabs or Hume voices.",
    "permissions": ["storage", "tabs"],
    "host_permissions": [
        "*://*.poe.com/*",
        "https://api.elevenlabs.io/*",
        "https://api.hume.ai/*",
        "https://gds-g.github.io/*"
    ],
    "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" },
    "background": { "scripts": ["background.js"], "type": "module" },
    "browser_specific_settings": {
        "gecko": {
            "id": "poe-voice-sync@gds-g.github.io",
            "data_collection_permissions": {
                "required": ["authenticationInfo", "websiteContent"]
            },
            "strict_min_version": "140.0"
        }
    },
    "content_scripts": [
        {
            "matches": ["*://*.poe.com/*"],
            "js": ["tts.js", "tts-bridge.js", "content.js"],
            "run_at": "document_end"
        },
        {
            "matches": ["https://gds-g.github.io/Poe-Voice-Sync/payment/payment.html*"],
            "js": ["payment-bridge.js"],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["icons/*"],
            "matches": ["*://*.poe.com/*", "https://gds-g.github.io/*"]
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
    },
    "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
